# lsf configuration
# Copy this file to ~/.config/lsf/config.toml and edit to match your schedule.
#
# Define one or more time windows per day type.
# Use 24-hour "HH:MM" strings.

[defaults]
risk_multiplier    = 1.4   # estimates multiplied by this (Hofstadter buffer)
switch_penalty_min = 10    # minutes lost when switching between tasks

# ── Standard 9-5 workday ─────────────────────────────────────────────────────

[weekday]
windows = [
  { start = "09:00", end = "17:00" },
]

[weekend]
windows = [
  { start = "09:00", end = "17:00" },
]

# ── Student / school schedule example ────────────────────────────────────────
# Uncomment and replace the blocks above to use this instead.
#
# [weekday]
# windows = [
#   { start = "10:15", end = "10:35" },
#   { start = "12:50", end = "13:15" },
#   { start = "19:30", end = "21:30" },
# ]
#
# [weekend]
# windows = [
#   { start = "13:00", end = "15:00" },
#   { start = "17:00", end = "17:30" },
#   { start = "19:30", end = "22:30" },
# ]
